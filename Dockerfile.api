
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Create a non-root application user
RUN useradd --create-home --uid 10001 appuser

# Copy application files
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser data/ ./data/
COPY --chown=appuser:appuser evaluation/ ./evaluation/

# Create writable application directories
RUN mkdir -p /app/chroma_db /app/hf_cache \
    && chown -R appuser:appuser /app/chroma_db /app/hf_cache

# Run the API as a non-root user
USER appuser

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
